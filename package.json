    "build:preipo": "node launch/src/build.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.24.0"
  }
}
