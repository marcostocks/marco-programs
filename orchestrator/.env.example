# ---------------------------------------------------------------------------
# Marco Orchestrator — example environment
# Copy to .env. Never commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Operator API auth. Comma-separated bearer tokens; rotate by adding then removing.
# In production these come from a secrets manager, not a file.
OPERATOR_API_TOKENS=dev-operator-token

# Provider selection. `mock` runs the deterministic in-process simulators.
MSB_PROVIDER=mock
BROKER_PROVIDER=mock
CUSTODIAN_PROVIDER=mock
CHAIN_PROVIDER=mock
COMPLIANCE_PROVIDER=mock

# Inbound webhook HMAC secrets, one per counterparty.
MSB_WEBHOOK_SECRET=dev-msb-secret
BROKER_WEBHOOK_SECRET=dev-broker-secret
CUSTODIAN_WEBHOOK_SECRET=dev-custodian-secret

# Reject webhooks whose signed timestamp is older than this (replay window).
WEBHOOK_TOLERANCE_SECONDS=300

# ---- Treasury (hybrid funding model) --------------------------------------
# All amounts in minor units. HKD scale 2, USDC scale 6.

# Working balance held with the broker so orders execute without waiting on FX.
TREASURY_HKD_TARGET=500000000        # 5,000,000.00 HKD
TREASURY_HKD_MINIMUM=150000000       # 1,500,000.00 HKD — below this, top up
TREASURY_HKD_TOPUP_INCREMENT=250000000

# USDC held to pay sell proceeds before repatriation lands.
TREASURY_USDC_TARGET=500000000000    # 500,000.000000 USDC
TREASURY_USDC_MINIMUM=150000000000

# A single intent may never reserve more than this from the buffer.
TREASURY_MAX_SINGLE_RESERVATION_HKD=100000000

# ---- Solana ----------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
SPOT_PROGRAM_ID=44PTF8po9JW5KK5VVH295XRFfNm1x9KuwcAVsvYGgn9e
VAULT_PROGRAM_ID=CgJnDJHjhkMgrkaky3Dp9dD89NzXRMP287bqmgCPMC8q

# Operator signer. `file` for local dev only; use `kms` or `squads` in production.
SIGNER_KIND=mock
SIGNER_KEYPAIR_PATH=

# ---- Runner ----------------------------------------------------------------
RUNNER_POLL_INTERVAL_MS=1000
RUNNER_MAX_ATTEMPTS=8
RUNNER_BASE_BACKOFF_MS=500
